# Реверс-прокси и TLS. Сертификат Caddy получает и продлевает сам:
# SITE_ADDR — доменное имя, и этого достаточно, чтобы заработал ACME.
#
# SITE_ADDR и ACME_EMAIL приходят из /opt/kosynka/.env.site — файла, который
# создаётся на сервере руками и в git не хранится.

{
	# Сюда Let's Encrypt пришлёт предупреждение, если продление однажды
	# перестанет работать.
	email {$ACME_EMAIL}
}

{$SITE_ADDR} {
	# Потолок на тело запроса. Не валидация содержимого — deal_cards и replay
	# как принимались без единой проверки, так и принимаются, — а защита диска:
	# они складываются в JSONB как есть, автобэкапов у базы нет, и один клиент
	# с ретраями забил бы том за вечер. Проверено: без этой строки партия
	# с телом в 7.5 МБ принимается и целиком уезжает в базу.
	#
	# Реплей честной партии — килобайты, так что мегабайт с многократным
	# запасом. Превышение Caddy отвергает сам, до приложения запрос не доходит.
	request_body {
		max_size 1MB
	}

	reverse_proxy app:8000

	encode gzip

	log {
		output stdout
		format console
	}
}
